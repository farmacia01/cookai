      "id": "get_subs",
      "name": "HTTP: Get Subscriptions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-500, 310]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $('Set Notification Payload').first().json;\nconst input = items[0]?.json;\nconst rows = Array.isArray(input) ? input : (Array.isArray(input?.data) ? input.data : items.map(i => i.json));\nreturn rows.map((sub) => ({\n  json: {\n    subscription_id: sub.id,\n    endpoint: sub.endpoint,\n    keys: {\n      p256dh: sub.keys?.p256dh ?? sub.p256dh,\n      auth: sub.keys?.auth ?? sub.auth,\n    },\n    payload\n  }\n}));"
      },
      "id": "normalize",
      "name": "Code: Normalize Subscriptions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-260, 310]
    },
    {
      "parameters": {
        "batchSize": 50,
        "options": {}
      },
      "id": "batch",
      "name": "Split In Batches (50)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-20, 310]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const webpush = require('web-push');\nconst cfg = $('Config').first().json;\nwebpush.setVapidDetails(cfg.vapid_subject, cfg.vapid_public_key, cfg.vapid_private_key);\n\nconst payload = {\n  title: $json.payload.title,\n  body: $json.payload.body,\n  url: $json.payload.url,\n  icon: $json.payload.icon,\n  badge: $json.payload.badge,\n  tag: $json.payload.tag\n};\n\nconst subscription = {\n  endpoint: $json.endpoint,\n  keys: { p256dh: $json.keys?.p256dh, auth: $json.keys?.auth }\n};\n\ntry {\n  const response = await webpush.sendNotification(subscription, JSON.stringify(payload));\n  return [{ json: {\n    subscription_id: $json.subscription_id,\n    title: payload.title,\n    body: payload.body,\n    url: payload.url,\n    status: 'sent',\n    error: null,\n    statusCode: response.statusCode || 201\n  } }];\n} catch (err) {\n  const code = err?.statusCode || err?.status || 500;\n  const expired = code === 404 || code === 410;\n  return [{ json: {\n    subscription_id: $json.subscription_id,\n    title: payload.title,\n    body: payload.body,\n    url: payload.url,\n    status: expired ? 'expired' : 'error',\n    error: err?.body || err?.message || 'Unknown push error',\n    statusCode: code\n  } }];\n}"
      },
