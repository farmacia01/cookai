    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const templates = [\n  { title: 'Receita econômica para hoje', body: 'Monte uma refeição barata com o que você já tem em casa.', tag: 'economica-dia', audience: 'all' },\n  { title: 'Receita GLP-1 rica em proteína', body: 'Uma sugestão leve, barata e proteica para sua rotina.', tag: 'glp1-proteina', audience: 'all' },\n  { title: 'Sem ideia do que cozinhar?', body: 'Tire uma foto da geladeira e deixe a IA criar sua receita.', tag: 'lembrete-cozinhar', audience: 'all' },\n  { title: 'Seu limite grátis está acabando', body: 'Faça upgrade para Premium e continue gerando receitas ilimitadas.', tag: 'limite-gratis', audience: 'all' },\n  { title: 'Premium com desconto hoje', body: 'Desbloqueie receitas avançadas e planos personalizados.', tag: 'premium-promo', audience: 'all' },\n  { title: 'Receita rápida com ingredientes comuns', body: 'Em minutos você transforma o que já tem em uma refeição completa.', tag: 'receita-rapida', audience: 'all' }\n];\nconst picked = templates[Math.floor(Math.random() * templates.length)];\nreturn [{ json: { ...picked, url: '/', icon: '/icons/icon-192.png', badge: '/icons/badge-72.png' } }];"
      },
