    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const templates = [\n  {\n    title: 'Receita econômica para hoje',\n    body: 'Monte uma refeição barata com o que você já tem em casa.',\n    tag: 'economica-dia',\n    audience: 'all'\n  },\n  {\n    title: 'Receita GLP-1 rica em proteína',\n    body: 'Uma sugestão leve, barata e proteica para sua rotina.',\n    tag: 'glp1-proteina',\n    audience: 'all'\n  },\n  {\n    title: 'Sem ideia do que cozinhar?',\n    body: 'Tire uma foto da geladeira e deixe a IA criar sua receita.',\n    tag: 'lembrete-cozinhar',\n    audience: 'all'\n  },\n  {\n    title: 'Seu limite grátis está acabando',\n    body: 'Faça upgrade para Premium e continue gerando receitas ilimitadas.',\n    tag: 'limite-gratis',\n    audience: 'all'\n  },\n  {\n    title: 'Premium com desconto hoje',\n    body: 'Desbloqueie receitas avançadas e planos personalizados.',\n    tag: 'premium-promo',\n    audience: 'all'\n  },\n  {\n    title: 'Receita rápida com ingredientes comuns',\n    body: 'Em minutos você transforma o que já tem em uma refeição completa.',\n    tag: 'receita-rapida',\n    audience: 'all'\n  }\n];\n\nconst index = Math.floor(Math.random() * templates.length);\nconst picked = templates[index];\n\nreturn [{\n  json: {\n    ...picked,\n    url: '/',\n    icon: '/icons/icon-192.png',\n    badge: '/icons/badge-72.png'\n  }\n}];"
      },
