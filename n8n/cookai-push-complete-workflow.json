    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const webpush = require('web-push');\n\nwebpush.setVapidDetails(\n  $env.VAPID_SUBJECT,\n  $env.VAPID_PUBLIC_KEY,\n  $env.VAPID_PRIVATE_KEY\n);\n\nconst subscriptionId = $json.subscription_id;\nconst subscription = {\n  endpoint: $json.endpoint,\n  keys: {\n    p256dh: $json.keys?.p256dh,\n    auth: $json.keys?.auth,\n  },\n};\n\nconst payload = {\n  title: $json.payload.title,\n  body: $json.payload.body,\n  url: $json.payload.url,\n  icon: $json.payload.icon,\n  badge: $json.payload.badge,\n  tag: $json.payload.tag,\n};\n\ntry {\n  const response = await webpush.sendNotification(subscription, JSON.stringify(payload));\n  return [{\n    json: {\n      subscription_id: subscriptionId,\n      title: payload.title,\n      body: payload.body,\n      url: payload.url,\n      status: 'sent',\n      error: null,\n      statusCode: response.statusCode || 201\n    }\n  }];\n} catch (err) {\n  const statusCode = err?.statusCode || err?.status || 500;\n  const expired = statusCode === 404 || statusCode === 410;\n\n  return [{\n    json: {\n      subscription_id: subscriptionId,\n      title: payload.title,\n      body: payload.body,\n      url: payload.url,\n      status: expired ? 'expired' : 'error',\n      error: err?.body || err?.message || 'Unknown push error',\n      statusCode\n    }\n  }];\n}"
      },
