    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $('Set Notification Payload').first().json;\nconst input = items[0]?.json;\nconst rows = Array.isArray(input) ? input : (Array.isArray(input?.data) ? input.data : items.map(i => i.json));\n\nreturn rows.map((sub) => ({\n  json: {\n    subscription_id: sub.id,\n    endpoint: sub.endpoint,\n    keys: {\n      p256dh: sub.keys?.p256dh ?? sub.p256dh,\n      auth: sub.keys?.auth ?? sub.auth,\n    },\n    payload\n  }\n}));"
      },
      "id": "normalize_subscriptions",
      "name": "Code: Normalize Subscriptions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        270
      ]
    },
    {
      "parameters": {
        "batchSize": 50,
        "options": {}
